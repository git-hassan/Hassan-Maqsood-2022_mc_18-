<?xml version="1.0"?>
<robot name="snowbot">

  <!-- THIN FLAT WHITE BASE PLATE -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.36 0.42 0.06"/>
      </geometry>
      <material name="base_white">
        <color rgba="0.93 0.93 0.95 1"/>
      </material>
    </visual>
  </link>

  <!-- BOTTOM SNOW SPHERE — sits on plate -->
  <link name="bottom_sphere">
    <visual>
      <geometry>
        <sphere radius="0.18"/>
      </geometry>
      <material name="snow1">
        <color rgba="0.95 0.95 0.97 1"/>
      </material>
    </visual>
  </link>

  <!-- MID SNOW SPHERE -->
  <link name="mid_sphere">
    <visual>
      <geometry>
        <sphere radius="0.13"/>
      </geometry>
      <material name="snow2">
        <color rgba="0.95 0.95 0.97 1"/>
      </material>
    </visual>
  </link>

  <!-- HEAD SPHERE -->
  <link name="head">
    <visual>
      <geometry>
        <sphere radius="0.09"/>
      </geometry>
      <material name="snow3">
        <color rgba="0.95 0.95 0.97 1"/>
      </material>
    </visual>
  </link>

  <!-- NOSE -->
  <link name="nose">
    <visual>
      <geometry>
        <cylinder length="0.055" radius="0.012"/>
      </geometry>
      <material name="nose_col">
        <color rgba="0.95 0.45 0.05 1"/>
      </material>
    </visual>
  </link>

  <!-- EYES -->
  <link name="eye_left">
    <visual><geometry><sphere radius="0.018"/></geometry>
    <material name="el"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>
  <link name="eye_right">
    <visual><geometry><sphere radius="0.018"/></geometry>
    <material name="er"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>

  <!-- SMILE DOTS -->
  <link name="smile1">
    <visual><geometry><sphere radius="0.010"/></geometry>
    <material name="s1"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>
  <link name="smile2">
    <visual><geometry><sphere radius="0.010"/></geometry>
    <material name="s2"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>
  <link name="smile3">
    <visual><geometry><sphere radius="0.010"/></geometry>
    <material name="s3"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>

  <!-- HAT BRIM -->
  <link name="hat_brim">
    <visual><geometry><cylinder length="0.018" radius="0.115"/></geometry>
    <material name="hat1"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>

  <!-- HAT TOP -->
  <link name="hat_top">
    <visual><geometry><cylinder length="0.12" radius="0.072"/></geometry>
    <material name="hat2"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>

  <!-- HAT BAND -->
  <link name="hat_band">
    <visual><geometry><cylinder length="0.016" radius="0.074"/></geometry>
    <material name="band"><color rgba="0.88 0.04 0.04 1"/></material></visual>
  </link>

  <!-- LIDAR -->
  <link name="lidar">
    <visual><geometry><cylinder length="0.025" radius="0.035"/></geometry>
    <material name="lidar_col"><color rgba="0.88 0.04 0.04 1"/></material></visual>
  </link>

  <!-- LEFT SHOULDER SPHERE -->
  <link name="left_shoulder">
    <visual><geometry><sphere radius="0.045"/></geometry>
    <material name="lsh"><color rgba="0.93 0.93 0.95 1"/></material></visual>
  </link>

  <!-- RIGHT SHOULDER SPHERE -->
  <link name="right_shoulder">
    <visual><geometry><sphere radius="0.045"/></geometry>
    <material name="rsh"><color rgba="0.93 0.93 0.95 1"/></material></visual>
  </link>

  <!-- LEFT DRIVE WHEEL -->
  <link name="left_wheel">
    <visual><geometry><cylinder length="0.055" radius="0.072"/></geometry>
    <material name="wl"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>
  <link name="left_hub">
    <visual><geometry><cylinder length="0.057" radius="0.026"/></geometry>
    <material name="hl"><color rgba="0.88 0.04 0.04 1"/></material></visual>
  </link>

  <!-- RIGHT DRIVE WHEEL -->
  <link name="right_wheel">
    <visual><geometry><cylinder length="0.055" radius="0.072"/></geometry>
    <material name="wr"><color rgba="0.08 0.08 0.08 1"/></material></visual>
  </link>
  <link name="right_hub">
    <visual><geometry><cylinder length="0.057" radius="0.026"/></geometry>
    <material name="hr"><color rgba="0.88 0.04 0.04 1"/></material></visual>
  </link>

  <!-- CASTERS -->
  <link name="caster_front">
    <visual><geometry><sphere radius="0.030"/></geometry>
    <material name="cf"><color rgba="0.20 0.20 0.20 1"/></material></visual>
  </link>
  <link name="caster_rear">
    <visual><geometry><sphere radius="0.030"/></geometry>
    <material name="cr"><color rgba="0.20 0.20 0.20 1"/></material></visual>
  </link>

  <!-- ============================================================
        JOINTS
  ============================================================ -->

  <!-- Bottom sphere on plate -->
  <joint name="bottom_sphere_joint" type="fixed">
    <parent link="base_link"/>
    <child link="bottom_sphere"/>
    <origin xyz="0 0 0.210" rpy="0 0 0"/>
  </joint>

  <!-- Mid sphere -->
  <joint name="mid_sphere_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mid_sphere"/>
    <origin xyz="0 0 0.420" rpy="0 0 0"/>
  </joint>

  <!-- Head -->
  <joint name="head_joint" type="fixed">
    <parent link="base_link"/>
    <child link="head"/>
    <origin xyz="0 0 0.585" rpy="0 0 0"/>
  </joint>

  <!-- Nose -->
  <joint name="nose_joint" type="fixed">
    <parent link="base_link"/>
    <child link="nose"/>
    <origin xyz="0.085 0 0.590" rpy="0 1.5708 0"/>
  </joint>

  <!-- Eyes -->
  <joint name="eye_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="eye_left"/>
    <origin xyz="0.082 0.035 0.608" rpy="0 0 0"/>
  </joint>
  <joint name="eye_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="eye_right"/>
    <origin xyz="0.082 -0.035 0.608" rpy="0 0 0"/>
  </joint>

  <!-- Smile -->
  <joint name="smile1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="smile1"/>
    <origin xyz="0.086 -0.030 0.568" rpy="0 0 0"/>
  </joint>
  <joint name="smile2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="smile2"/>
    <origin xyz="0.088 0 0.562" rpy="0 0 0"/>
  </joint>
  <joint name="smile3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="smile3"/>
    <origin xyz="0.086 0.030 0.568" rpy="0 0 0"/>
  </joint>

  <!-- Hat -->
  <joint name="hat_brim_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hat_brim"/>
    <origin xyz="0 0 0.680" rpy="0 0 0"/>
  </joint>
  <joint name="hat_band_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hat_band"/>
    <origin xyz="0 0 0.696" rpy="0 0 0"/>
  </joint>
  <joint name="hat_top_joint" type="fixed">
    <parent link="base_link"/>
    <child link="hat_top"/>
    <origin xyz="0 0 0.750" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="0 0 0.823" rpy="0 0 0"/>
  </joint>

  <!-- Left and Right Shoulders ONLY (Arms and Hands removed) -->
  <joint name="left_shoulder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_shoulder"/>
    <origin xyz="0 0.175 0.420" rpy="0 0 0"/>
  </joint>

  <joint name="right_shoulder_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_shoulder"/>
    <origin xyz="0 -0.175 0.420" rpy="0 0 0"/>
  </joint>

  <!-- Drive wheels — level with plate, extend out to the sides -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.238 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="left_hub_joint" type="fixed">
    <parent link="left_wheel"/>
    <child link="left_hub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.238 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <joint name="right_hub_joint" type="fixed">
    <parent link="right_wheel"/>
    <child link="right_hub"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Casters under plate with ground clearance -->
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.15 0 -0.050" rpy="0 0 0"/>
  </joint>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.15 0 -0.050" rpy="0 0 0"/>
  </joint>

</robot>
